{
  "name": "clipboard-spike",
  "version": "1.0.12",
  "description": "剪贴板程序可行性 spike demo —— 验证：剪贴板轮询监听 → 面板展示 → 点击回写",
  "main": "dist/main/index.js",
  "scripts": {
    "prestart": "npm run build:ts",
    "start": "electron .",
    "prestart:dev": "npm run build:ts",
    "start:dev": "set NODE_ENV=development&& electron .",
    "build:ts": "tsc && node scripts/copy-assets.js",
    "build": "npm run build:ts && electron-builder",
    "build:win": "npm run build:ts && electron-builder --win",
    "gen:icon": "node scripts/gen-icon.js"
  },
  "keywords": [
    "clipboard",
    "electron",
    "spike"
  ],
  "author": "产品 spike",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "koffi": "^3.1.6"
  },
  "build": {
    "appId": "com.openclaw.ClipSense",
    "productName": "ClipSense",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "scripts/**/*",
      "package.json",
      "README.md"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/app-icon.png"
    },
    "nsis": {
      "include": "build/installer.nsh"
    }
  }
}
