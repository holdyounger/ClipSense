{
  "name": "clipboard-spike",
  "version": "1.0.16",
  "description": "剪贴板程序可行性 spike demo —— 验证：剪贴板轮询监听 → 面板展示 → 点击回写",
  "main": "dist/main/index.js",
  "scripts": {
    "prestart": "npm run build:ts",
    "start": "electron .",
    "prestart:dev": "npm run build:ts",
    "start:dev": "set NODE_ENV=development&& electron .",
    "build:ts": "tsc && node scripts/copy-assets.js",
    "test": "node --test tests/*.test.js",
    "build": "npm run build:ts && electron-builder",
    "build:win": "npm run build:ts && electron-builder --win",
    "gen:icon": "node scripts/gen-icon.js",
    "build:mac": "npm run build:ts && electron-builder --mac"
  },
  "keywords": [
    "clipboard",
    "electron",
    "spike"
  ],
  "author": "产品 spike",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "koffi": "^3.1.6",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.openclaw.ClipSense",
    "productName": "ClipSense",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "scripts/**/*",
      "package.json",
      "README.md"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/app-icon.png"
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "MIT License",
        "NSAppleEventsUsageDescription": "ClipSense 需要控制其他应用以完成自动粘贴。"
      }
    },
    "dmg": {
      "title": "ClipSense ${version}"
    }
  }
}
