{
  "name": "clipboard-spike",
  "version": "0.1.0",
  "description": "剪贴板程序可行性 spike demo —— 验证：剪贴板轮询监听 → 面板展示 → 点击回写",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "set NODE_ENV=development&& electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "gen:icon": "node scripts/gen-icon.js"
  },
  "keywords": ["clipboard", "electron", "spike"],
  "author": "产品 spike",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "build": {
    "appId": "com.openclaw.ClipSense",
    "productName": "ClipSense",
    "directories": {
      "output": "build"
    },
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "README.md",
      "Docs/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/app-icon.png"
    }
  }
}
